import stripe
import uuid
import time

class UnifiedPlatformEngine:
    def __init__(self, stripe_api_key, owner_eth_address):
        stripe.api_key = stripe_api_key
        self.owner_address = owner_eth_address
        
        # Internal Ledger Systems
        self.worker_token_balances = {}
        self.worker_debt_balances = {}
        self.task_database_logs = []
        
        # Financial Matrices
        self.base_tokens_per_hour = 1.0
        self.client_billing_rate_usd = 25.00
        self.total_stripe_cash_collected = 0.0

    # --- Worker Management & Multipliers ---
    def issue_worker_advance(self, worker_address, advance_amount_tokens):
        """Issues upfront credit tokens to workers for immediate commodity use."""
        if worker_address not in self.worker_debt_balances:
            self.worker_debt_balances[worker_address] = 0.0
        if worker_address not in self.worker_token_balances:
            self.worker_token_balances[worker_address] = 0.0
            
        self.worker_debt_balances[worker_address] += advance_amount_tokens
        self.worker_token_balances[worker_address] += advance_amount_tokens
        return f"Advanced {advance_amount_tokens} WHT to {worker_address}."

    def log_completed_task(self, worker_address, hours_spent, task_type, client_id):
        """Logs task metrics and applies a 10% bonus multiplier if the user carries active debt."""
        task_id = str(uuid.uuid4())
        calculated_payout = hours_spent * self.base_tokens_per_hour
        
        # Standard Rules Multiplier Check
        has_active_debt = self.worker_debt_balances.get(worker_address, 0.0) > 0
        applied_multiplier = 1.0
        if has_active_debt:
            applied_multiplier = 1.10  # 10% dynamic acceleration bonus
            calculated_payout *= applied_multiplier

        # Log metrics dynamically for client auditing
        task_entry = {
            "task_id": task_id,
            "worker": worker_address,
            "hours": hours_spent,
            "task_type": task_type,
            "client_id": client_id,
            "multiplier_applied": applied_multiplier,
            "final_payout_tokens": calculated_payout,
            "timestamp": time.time()
        }
        self.task_database_logs.append(task_entry)
        
        # Update user ledgers
        if worker_address not in self.worker_token_balances:
            self.worker_token_balances[worker_address] = 0.0
        self.worker_token_balances[worker_address] += calculated_payout
        
        # Automatically pay down debt with the base portion of work if applicable
        if has_active_debt:
            debt_deduction = min(self.worker_debt_balances[worker_address], hours_spent * self.base_tokens_per_hour)
            self.worker_debt_balances[worker_address] -= debt_deduction
            
        return task_id, calculated_payout

    def administrative_balance_override(self, worker_address, target_balance):
        """Provides absolute manual override control over worker platform balances."""
        self.worker_token_balances[worker_address] = float(target_balance)
        return True

    # --- Stripe B2B Client Billing Flow ---
    def generate_and_send_b2b_invoice(self, client_id, client_email):
        """Programmatically queries database logs to build and finalize Stripe B2B customer invoices."""
        client_tasks = [t for t in self.task_database_logs if t["client_id"] == client_id]
        total_hours = sum(t["hours"] for t in client_tasks)
        total_usd_cents = int(total_hours * self.client_billing_rate_usd * 100)
        
        if total_usd_cents == 0:
            return "No billable entries located."

        # Create or fetch customer profile on Stripe
        customer = stripe.Customer.create(email=client_email, description=f"B2B Client {client_id}")
        
        # Generate Line Item
        stripe.InvoiceItem.create(
            customer=customer.id,
            amount=total_usd_cents,
            currency="usd",
            description=f"Accumulated Labor Processing: {total_hours} Hours @ ${self.client_billing_rate_usd}/hr"
        )
        
        # Issue Invoice
        invoice = stripe.Invoice.create(customer=customer.id, auto_advance=True)
        finalized_invoice = stripe.Invoice.finalize_invoice(invoice.id)
        
        return finalized_invoice.invoice_pdf

    def process_incoming_stripe_webhook(self, event_payload, signature_header, webhook_secret):
        """Parses real-time Stripe webhooks to verify cleared cash payments into your account."""
        try:
            event = stripe.Webhook.construct_event(event_payload, signature_header, webhook_secret)
        except Exception as e:
            return f"Webhook validation failure: {str(e)}"
            
        if event["type"] == "invoice.payment_succeeded":
            invoice_data = event["data"]["object"]
            received_amount_usd = invoice_data["amount_paid"] / 100.0
            self.total_stripe_cash_collected += received_amount_usd
            return f"Payment Confirmed: ${received_amount_usd} added to corporate vault."
        return "Event unhandled."
