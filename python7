def admin_required(f):
    """Custom decorator route guard ensuring only Russell Stone can access endpoints."""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        token = request.headers.get('Authorization')
        if not token:
            return jsonify({"status": "Access Denied", "reason": "Missing authorization token."}), 401
        try:
            # Strip 'Bearer ' prefix if present
            if "Bearer " in token:
                token = token.split(" ")[1]
            decoded = jwt.decode(token, app.config['JWT_SECRET_KEY'], algorithms=["HS256"])
            if decoded.get("email") != ADMIN_EMAIL:
                return jsonify({"status": "Access Denied", "reason": "Unauthorized administrator identity."}), 403
        except jwt.ExpiredSignatureError:
            return jsonify({"status": "Access Denied", "reason": "Session expired."}), 401
        except jwt.InvalidTokenError:
            return jsonify({"status": "Access Denied", "reason": "Invalid session token."}), 401
        return f(*args, **kwargs)
    return decorated_function

