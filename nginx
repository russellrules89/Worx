server {
    listen 80;
    server_name your-domain.com ://your-domain.com; # Replace with your registered domain name

    # Root location mapping to the Flask Gunicorn application daemon
    location / {
        proxy_pass http://127.0.0.1:4242;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Internal location verification for Certbot Let's Encrypt validation challenges
    location ~ /.well-known/acme-challenge {
        allow all;
        root /var/www/html;
    }
}
