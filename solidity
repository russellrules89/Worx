import uuid
import time

class LaborPlatformEngine:
    def __init__(self, owner_address):
        self.owner = owner_address
        self.worker_balances = {}
        self.owner_cash_pool = 0.0
        self.task_logs = []
        self.base_hourly_rate = 1.0  # 1 Token per hour
        
    def log_completed_task(self, worker_address, hours_spent, task_type, client_id):
        """Logs completed task and calculates token distribution."""
        task_id = str(uuid.uuid4())
        tokens_earned = hours_spent * self.base_hourly_rate
        
        # Log details for B2B client invoicing
        task_entry = {
            "task_id": task_id,
            "worker": worker_address,
            "hours": hours_spent,
            "task_type": task_type,
            "client_id": client_id,
            "timestamp": time.time(),
            "status": "Verified"
        }
        self.task_logs.append(task_entry)
        
        # Credit the worker's platform ledger balance
        if worker_address not in self.worker_balances:
            self.worker_balances[worker_address] = 0.0
        self.worker_balances[worker_address] += tokens_earned
        
        return task_id, tokens_earned

    def adjust_worker_balance(self, worker_address, new_balance):
        """Allows sole administrator override of platform balances."""
        self.worker_balances[worker_address] = float(new_balance)
        return True
