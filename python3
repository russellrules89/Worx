class VoucherFulfillmentGateway:
    def __init__(self, platform_engine, market_token_value_usd=15.00):
        self.engine = platform_engine
        self.token_value_in_usd = market_token_value_usd  # Baseline exchange index
        self.issued_vouchers = []

    def verify_live_badge_and_redeem(self, worker_address, token_amount, provider_category):
        """API Endpoint: Checks live balance, executes burn, and prints commercial commodity codes."""
        current_balance = self.engine.worker_token_balances.get(worker_address, 0.0)
        
        if current_balance < token_amount:
            return {"status": "Rejected", "reason": "Insufficient balance for instant fulfillment."}
            
        # Deduct tokens from system ledger
        self.engine.worker_token_balances[worker_address] -= token_amount
        
        # Calculate digital voucher face value
        voucher_usd_worth = token_amount * self.token_value_in_usd
        redemption_code = f"VAL-{provider_category.upper()}-{str(uuid.uuid4())[-12:]}"
        
        voucher_receipt = {
            "redemption_code": redemption_code,
            "allocated_to": worker_address,
            "commodity_provider": provider_category, # Gas, Electric, Food
            "face_value_usd": voucher_usd_worth,
            "status": "Active"
        }
        self.issued_vouchers.append(voucher_receipt)
        return {"status": "Success", "voucher": voucher_receipt}
