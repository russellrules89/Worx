# Local development only. Never commit .env or real credentials.
PORT=5000
FLASK_ENV=production
FLASK_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYOUT_MULTIPLIER=1.10
TOKEN_CONTRACT_ADDRESS=
# Legacy alias; use TOKEN_CONTRACT_ADDRESS for new deployments.
ETHEREUM_CONTRACT_ADDRESS=
CONTRACT_ADMIN_API_KEY=
# Keep false until legal, KYC/AML, custody, tax, and jurisdictional controls are live.
TOKEN_SALE_ENABLED=false
# Consent and integrations are disabled until a provider and retention policy are approved.
CONSENT_POLICY_VERSION=2026-08-preview
IDENTITY_VERIFICATION_PROVIDER=
# Base Sepolia only (chain ID 84532). Requires a deployed ERC-20 contract and an authenticated oracle service.
BASE_SEPOLIA_SETTLEMENT_ENABLED=false
MINIMUM_CASHOUT_WORK=100
# Optional: enables model-backed answers through Vercel AI Gateway. Leave blank to use the built-in portal guide.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# 402 paid data packets. Production verification is fail-closed until both values are set.
# Configure these for your Skyfire-compatible payment settlement verifier.
PAYMENT_402_PROVIDER=skyfire-compatible
PAYMENT_402_VERIFIER_URL=
PAYMENT_402_VERIFIER_API_KEY=
