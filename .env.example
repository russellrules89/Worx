# Local development only. Never commit .env or real credentials.
PORT=5000
FLASK_ENV=production
FLASK_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYOUT_MULTIPLIER=1.10
ETHEREUM_CONTRACT_ADDRESS=
CONTRACT_ADMIN_API_KEY=
# Keep false until legal, KYC/AML, custody, tax, and jurisdictional controls are live.
TOKEN_SALE_ENABLED=false
# Consent and integrations are disabled until a provider and retention policy are approved.
CONSENT_POLICY_VERSION=2026-08-preview
IDENTITY_VERIFICATION_PROVIDER=
EVM_TESTNET_CHAIN_ID=
EVM_NETWORK_NAME=
# Testnet-only. Requires a deployed ERC-20 contract and an authenticated oracle service.
TESTNET_SETTLEMENT_ENABLED=false
MINIMUM_CASHOUT_WORK=100
