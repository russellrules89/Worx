#!/bin/bash

# Terminate execution immediately if any step reports an error
set -e

echo "=========================================================="
echo " RUNNING FULL COMPREHENSIVE RECONSTRUCTION & DEPLOYMENT   "
echo " Administrator: russellrules89@gmail.com                 "
echo "=========================================================="

# 1. Base Environment Provisioning
echo "[1/6] Syncing operating system dependencies..."
sudo apt-get update -y
sudo apt-get install -y python3-pip python3-venv nginx certbot python3-certbot-nginx curl git

# 2. Project Directory Realignment
PROJECT_DIR="/opt/labor_backed_currency"
echo "[2/6] Ensuring project directory space is configured..."
sudo mkdir -p $PROJECT_DIR
sudo chown -R $USER:$USER $PROJECT_DIR
cd $PROJECT_DIR

# 3. Python Package Configuration
echo "[3/6] Setting up production Python environment..."
cat << EOF > requirements.txt
Flask==3.0.2
stripe==8.3.0
PyJWT==2.8.0
web3==6.15.1
gunicorn==21.2.0
EOF

if [ ! -d "venv" ]; then
    python3 -m venv venv
fi
source venv/bin/activate
pip3 install --upgrade pip
pip3 install -r requirements.txt

# 4. System Service Engineering
echo "[4/6] Rewriting background gunicorn daemon execution parameters..."
sudo cat << EOF | sudo tee /etc/systemd/system/labor_platform.service
[Unit]
Description=Labor Backed Currency Application Backend
After=network.target

[Service]
User=$USER
WorkingDirectory=$PROJECT_DIR
ExecStart=$PROJECT_DIR/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:4242 main:app
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
EOF

# Reload and kickstart background application thread
sudo systemctl daemon-reload
sudo systemctl enable labor_platform.service
sudo systemctl restart labor_platform.service

# 5. Routing Layer Integration (Nginx)
echo "[5/6] Aligning Nginx reverse proxy framework..."
sudo cp labor_platform.conf /etc/nginx/sites-available/labor_platform.conf

# Enable server block link if not already initialized
if [ ! -f "/etc/nginx/sites-enabled/labor_platform.conf" ]; then
    sudo ln -s /etc/nginx/sites-available/labor_platform.conf /etc/nginx/sites-enabled/
fi

# Clean default configuration if present to avoid traffic overlaps
if [ -f "/etc/nginx/sites-enabled/default" ]; then
    sudo rm /etc/nginx/sites-enabled/default
fi

sudo nginx -t
sudo systemctl restart nginx

# 6. Automated SSL Certificate Generation via Certbot
echo "[6/6] Requesting SSL Certificate generation from Let's Encrypt..."
# Replace 'your-domain.com' with your actual registered domain point
# --nginx tells Certbot to read your configuration and inject the SSL pathways automatically
# --non-interactive allows the script to run seamlessly during GitHub execution loops
sudo certbot --nginx \
             -d your-domain.com \
             -d ://your-domain.com \
             --email russellrules89@gmail.com \
             --agree-tos \
             --no-eff-email \
             --non-interactive \
             --keep-until-expiring

echo "=========================================================="
echo " PIPELINE ACTIVE: PRODUCTION APP ONLINE                   "
echo " Secure Destination Node: https://your-domain.com        "
echo "=========================================================="
