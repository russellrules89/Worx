def print_owner_live_balance_sheet(engine, voucher_gateway):
    print("\n" + "="*50)
    print("      RUSSELL STONE: SYSTEM CONTROL PANELS      ")
    print("="*50)
    print(f" Sole Administrator / Platform Owner : Russell Stone")
    print(f" Active Smart Contract Custody Address: {engine.owner_address}")
    print("-"*50)
    print(" FINANCIAL CASH ACCOUNTING (STRIPE ESCROW)")
    print(f"  Total Real Cash Collected (USD)    : ${engine.total_stripe_cash_collected:,.2f}")
    print("-"*50)
    print(" WORKER REWARD SYSTEM ACCOUNTING")
    print("  Address          | Ledger Tokens | Outstanding Debt Advance")
    
    if not engine.worker_token_balances:
        print("  No active token distributions detected.")
    for worker in engine.worker_token_balances:
        tokens = engine.worker_token_balances[worker]
        debt = engine.worker_debt_balances.get(worker, 0.0)
        print(f"  {worker[:12]}... | {tokens:<13.2f} | {debt:<22.2f}")
        
    print("-"*50)
    print(" ACTIVE GLOBAL FULFILLMENT VOUCHERS")
    if not voucher_gateway.issued_vouchers:
        print("  No commodity redemptions processed yet.")
    for v in voucher_gateway.issued_vouchers:
        print(f"  Code: {v['redemption_code']} | Type: {v['commodity_provider']:<8} | Value: ${v['face_value_usd']:.2f} USD")
    print("="*50 + "\n")

