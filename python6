# LIVE REDEMPTION BADGE GATEWAY (API ENDPOINT)
# ==========================================
@app.route('/api/v1/voucher/redeem', methods=['POST'])
def live_badge_voucher_redeem():
    """Live frontend route backing the electronic commodity token check."""
    data = request.get_json()
    worker_address = data.get("worker_address")
    token_cost = float(data.get("token_cost", 0.0))
    provider_category = data.get("provider_category") # 'Gas', 'Electric', 'Food'
    
    if worker_address not in db_worker_ledgers:
        return jsonify({"status": "Rejected", "reason": "Profile ledger record absent."}), 404
        
    current_balance = db_worker_ledgers[worker_address]["token_balance"]
    if current_balance < token_cost:
        return jsonify({"status": "Rejected", "reason": "Insufficient balance for immediate redemption."}), 400
        
    # Deduct tokens from internal account system
    db_worker_ledgers[worker_address]["token_balance"] -= token_cost
    
    # Construct global retail clearing house vouchers
    face_value_cash_usd = token_cost * TOKEN_REVENUE_EXCHANGE_INDEX
    redemption_code = f"VAL-{provider_category.upper()}-{str(uuid.uuid4())[-12:]}"
    
    voucher_record = {
        "voucher_id": str(uuid.uuid4())[:8],
        "worker_address": worker_address,
        "provider_category": provider_category,
        "token_cost": token_cost,
        "face_value_usd": face_value_cash_usd,
        "redemption_code": redemption_code,
        "is_redeemed": False
    }
    db_commodity_vouchers.append(voucher_record)
    return jsonify({"status": "Success", "voucher": voucher_record}), 200


