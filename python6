def issue_immediate_worker_advance(worker_address, advance_amount_tokens):
    """Initializes worker ledger profiles and issues a commodity advance."""
    if worker_address not in db_worker_ledgers:
        db_worker_ledgers[worker_address] = {"token_balance": 0.0, "outstanding_debt": 0.0}
        
    db_worker_ledgers[worker_address]["outstanding_debt"] += advance_amount_tokens
    db_worker_ledgers[worker_address]["token_balance"] += advance_amount_tokens
    return f"Successfully issued a structural advance of {advance_amount_tokens} WHT."

def log_completed_task(worker_address, hours_spent, task_type, client_id):
    """
    Logs data tasks and voice processing records.
    Applies standard 10% multiplier rules if user has active advance debt.
    """
    if worker_address not in db_worker_ledgers:
        db_worker_ledgers[worker_address] = {"token_balance": 0.0, "outstanding_debt": 0.0}
        
    calculated_payout = hours_spent * BASE_TOKENS_PER_HOUR
    has_active_debt = db_worker_ledgers[worker_address]["outstanding_debt"] > 0
    applied_multiplier = 1.00
    
    if has_active_debt:
        applied_multiplier = 1.10  # Standard 10% debt acceleration multiplier rule
        calculated_payout *= applied_multiplier
        
    task_id = str(uuid.uuid4())
    task_entry = {
        "task_id": task_id,
        "worker_address": worker_address,
        "hours_worked": hours_spent,
        "task_type": task_type,
        "client_id": client_id,
        "multiplier_applied": applied_multiplier,
        "tokens_minted": calculated_payout,
        "timestamp": time.time()
    }
    db_labor_tasks_log.append(task_entry)
    
    # Credit the worker's balance account
    db_worker_ledgers[worker_address]["token_balance"] += calculated_payout
    
    # Standard Rule: Automatically amortize debt with base work allocations
    if has_active_debt:
        base_debt_deduction = min(db_worker_ledgers[worker_address]["outstanding_debt"], hours_spent * BASE_TOKENS_PER_HOUR)
        db_worker_ledgers[worker_address]["outstanding_debt"] -= base_debt_deduction
        
    return task_id, calculated_payout

def administrative_balance_override(worker_address, target_balance):
    """Provides Russell Stone full override controls to manually modify ledger states."""
    if worker_address not in db_worker_ledgers:
        db_worker_ledgers[worker_address] = {"token_balance": 0.0, "outstanding_debt": 0.0}
    db_worker_ledgers[worker_address]["token_balance"] = float(target_balance)
    return True


# ==========================================
# B2B STRIPE WEBHOOK INTEGRATION ENDPOINT
# ==========================================
@app.route('/stripe-webhook', methods=['POST'])
def stripe_webhook_listener():
    """
    Live frontend webhook endpoint that captures direct payments 
    originating from link: ://stripe.com
    """
    global total_stripe_cash_collected_usd
    payload = request.data
    sig_header = request.headers.get('HTTP_STRIPE_SIGNATURE')

    try:
        # Cryptographically confirm the incoming payload is authentic Stripe data
        event = stripe.Webhook.construct_event(payload, sig_header, STRIPE_WEBHOOK_SECRET)
    except (ValueError, stripe.error.SignatureVerificationError):
        return 'Signature Verification Failed', 400

    # Capture standard completed web checkout sessions
    if event['type'] == 'checkout.session.completed':
        session = event['data']['object']
        
        # Verify the underlying price details against your target link configurations
        line_items = stripe.checkout.Session.list_line_items(session['id'], limit=1)
        if line_items['data'] and line_items['data'][0]['price']['id'] == TARGET_PRICE_ID:
            
            # Extract real currency and route straight to your ledger pool
            received_cash_usd = session['amount_total'] / 100.0
            total_stripe_cash_collected_usd += received_cash_usd
            
            # Store standard invoice record into database logs
            invoice_entry = {
                "invoice_id": str(uuid.uuid4())[:8],
                "client_id": session.get("client_reference_id", "STRIPE_LINK_CLIENT"),
                "total_hours": received_cash_usd / CLIENT_BILLING_RATE_USD,
                "amount_due_usd": received_cash_usd,
                "payment_status": "paid",
                "stripe_session_id": session['id']
            }
            db_b2b_invoices.append(invoice_entry)
            
    return jsonify(success=True)


