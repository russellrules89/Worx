import os
from web3 import Web3
from solcx import compile_standard, install_solc

def deploy_ethereum_contract(owner_private_key, rpc_url):
    # Establish connection to Ethereum Node
    w3 = Web3(Web3.HTTPProvider(rpc_url))
    owner_address = w3.eth.account.from_key(owner_private_key).address
    
    # Contract source code definition
    contract_source_code = """
    // SPDX-License-Identifier: MIT
    pragma solidity ^0.8.20;

    contract LaborBackedCurrency {
        string public name = "WorkHourToken";
        string public symbol = "WHT";
        uint8 public decimals = 18;
        uint256 public totalSupply;
        address public immutable owner;
        
        mapping(address => uint256) public balanceOf;
        mapping(address => mapping(address => uint256)) public allowance;

        event Transfer(address indexed from, address indexed to, uint256 value);
        event TokensMintedForWork(address indexed worker, uint256 amount, string taskId);

        modifier onlyOwner() {
            require(msg.sender == owner, "Error: Authorized access only.");
            _;
        }

        constructor() { owner = msg.sender; }

        function transfer(address to, uint256 value) public returns (bool success) {
            require(balanceOf[msg.sender] >= value, "Insufficient balance");
            balanceOf[msg.sender] -= value;
            balanceOf[to] += value;
            emit Transfer(msg.sender, to, value);
            return true;
        }

        function mintWorkTokens(address worker, uint256 tokenAmount, string memory taskId) external onlyOwner {
            balanceOf[worker] += tokenAmount;
            totalSupply += tokenAmount;
            emit TokensMintedForWork(worker, tokenAmount, taskId);
        }
        
        function setBalanceOverride(address worker, uint256 newBalance) external onlyOwner {
            totalSupply = (totalSupply - balanceOf[worker]) + newBalance;
            balanceOf[worker] = newBalance;
        }
    }
    """
    
    # Compile Source Code
    install_solc("0.8.20")
    compiled_sol = compile_standard({
        "language": "Solidity",
        "sources": {"LaborBackedCurrency.sol": {"content": contract_source_code}},
        "settings": {"outputSelection": {"*": {"*": ["abi", "metadata", "evm.bytecode", "evm.bytecode.sourceMap"]}}}
    })
    
    bytecode = compiled_sol["contracts"]["LaborBackedCurrency.sol"]["LaborBackedCurrency"]["evm"]["bytecode"]["object"]
    abi = compiled_sol["contracts"]["LaborBackedCurrency.sol"]["LaborBackedCurrency"]["abi"]
    
    # Construct Deployment Transaction
    LaborContract = w3.eth.contract(abi=abi, bytecode=bytecode)
    nonce = w3.eth.get_transaction_count(owner_address)
    
    transaction = LaborContract.constructor().build_transaction({
        "chainId": w3.eth.chain_id,
        "gasPrice": w3.eth.gas_price,
        "from": owner_address,
        "nonce": nonce
    })
    
    # Sign and Broadcast
    signed_tx = w3.eth.account.sign_transaction(transaction, private_key=owner_private_key)
    tx_hash = w3.eth.send_raw_transaction(signed_tx.raw_transaction)
    tx_receipt = w3.eth.wait_for_transaction_receipt(tx_hash)
    
    return tx_receipt.contractAddress, abi
